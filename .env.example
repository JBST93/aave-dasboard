# Flask Configuration
APP_SETTINGS=config.DevelopmentConfig

# Database Connection
# -------------------
# For local development (SQLite - works out of the box):
DATABASE_URL2=sqlite:///instance/local.db

# For production (PostgreSQL):
# DATABASE_URL2=postgresql://username:password@hostname:5432/database_name
#
# Examples:
# - Local PostgreSQL: postgresql://postgres:password@localhost:5432/aave_dashboard
# - Heroku: postgres://user:pass@host:5432/dbname (auto-converted to postgresql://)
# - Render: postgresql://user:pass@host/dbname

# Security - CHANGE THESE IN PRODUCTION!
SECRET_KEY=dev-secret-key-change-in-production

# Admin Panel Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Blockchain RPC Keys (required for fetching protocol data)
INFURA_KEY=your_infura_api_key_here
# Get your key at: https://infura.io/

# Optional: Additional RPC endpoints
# ALCHEMY_KEY=your_alchemy_key
# QUICKNODE_URL=your_quicknode_endpoint
